# ============================================================
# 华科储能智能会议助手 — Git 忽略规则
# ============================================================

# --- 环境配置（含 API Key，绝对不能提交）---
.env
配置与模板/环境配置.env
配置与模板/火山密钥_*.py
!配置与模板/火山密钥_*.example.py

# --- Python 缓存 ---
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# --- 虚拟环境 ---
venv/
.venv/
env/

# --- 模型文件（太大，不提交）---
模型文件/*

# --- 录音缓存（临时文件）---
录音缓存/*
后端服务/录音缓存/*
*.wav
*.webm
*.mp3
*.m4a
!演示素材/测试音频_静音.wav
!录音缓存/.gitkeep
!后端服务/录音缓存/.gitkeep

# --- 历史记录（用户数据）---
历史记录/*
!历史记录/.gitkeep

# --- 调试文件 ---
.dbg/
debug-*.md

# --- IDE 配置 ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# --- 演示素材 ---
演示素材/*.wav
演示素材/*.mp3
